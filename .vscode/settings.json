{
    // Run pytest on the "test" folder
    "python.testing.pytestArgs": [],

    // Disable unittest (you are using pytest)
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,

    // Make VS Code run tests from the project root
    "python.testing.cwd": "${workspaceFolder}",

    // Ensure Python finds your source modules
    "python.testing.env": {
        "PYTHONPATH": "${workspaceFolder}"
    },

    // Optional: also set for integrated terminal if needed
    "terminal.integrated.env.osx": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${workspaceFolder}"
    }
}